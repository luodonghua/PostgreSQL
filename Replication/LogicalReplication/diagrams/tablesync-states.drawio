<mxfile host="app.diagrams.net"><diagram name="tablesync-states"><mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" page="1" pageWidth="940" pageHeight="250"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="i" value="i  init&lt;br&gt;queued; worker&lt;br&gt;not started" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="130" height="60" as="geometry"/></mxCell><mxCell id="d" value="d  data copy&lt;br&gt;temp slot + snapshot,&lt;br&gt;COPY running" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="190" y="60" width="150" height="60" as="geometry"/></mxCell><mxCell id="f" value="f  finished copy&lt;br&gt;(then in-memory w, c:&lt;br&gt;sync catches up to apply)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="150" height="60" as="geometry"/></mxCell><mxCell id="s" value="s  sync done&lt;br&gt;sync worker exits; apply&lt;br&gt;watches until that LSN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="570" y="60" width="150" height="60" as="geometry"/></mxCell><mxCell id="r" value="r  ready&lt;br&gt;normal replication;&lt;br&gt;temp slot dropped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="60" width="150" height="60" as="geometry"/></mxCell><mxCell id="n" value="Changes that commit during the copy are streamed from the&lt;br&gt;temp slot's start LSN and applied by the tablesync worker&lt;br&gt;after COPY (this is why no write is lost or doubled)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="190" y="160" width="340" height="60" as="geometry"/></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="i" target="d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="d" target="f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="f" target="s"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s" target="r"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" parent="1" source="d" target="n"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
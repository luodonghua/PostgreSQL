<mxfile host="app.diagrams.net"><diagram name="troubleshooting-tree"><mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" page="1" pageWidth="1700" pageHeight="800"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="root" value="Subscriber is behind / not changing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="690" y="20" width="320" height="44" as="geometry"/></mxCell><mxCell id="q1" value="Publisher: is the slot active?&lt;br&gt;(pg_replication_slots.active)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="690" y="100" width="320" height="50" as="geometry"/></mxCell><mxCell id="q2" value="Subscriber: subscription enabled?&lt;br&gt;(pg_subscription.subenabled)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="330" height="50" as="geometry"/></mxCell><mxCell id="a1" value="disabled&lt;br&gt;disable_on_error hit:&lt;br&gt;read the log, fix,&lt;br&gt;ENABLE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="160" height="90" as="geometry"/></mxCell><mxCell id="a2" value="enabled, no worker&lt;br&gt;connection errors:&lt;br&gt;pg_hba, password, TLS,&lt;br&gt;slots/senders in use" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="195" y="320" width="175" height="90" as="geometry"/></mxCell><mxCell id="L" value="Measure the LSN gaps on BOTH sides (sample twice)&lt;br&gt;G1 = cur_lsn - sent_lsn   G2 = sent_lsn - sub.received_lsn&lt;br&gt;G3 = received_lsn frozen?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="200" width="420" height="60" as="geometry"/></mxCell><mxCell id="g1" value="G1 large / growing&lt;br&gt;walsender behind reading WAL&lt;br&gt;-&gt; walsender wait event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="400" y="330" width="300" height="60" as="geometry"/></mxCell><mxCell id="g0" value="G1 small, nothing applied,&lt;br&gt;spill_* / stream_* rising" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="720" y="330" width="230" height="60" as="geometry"/></mxCell><mxCell id="g2" value="G2 &gt; logical_decoding_work_mem&lt;br&gt;received_lsn advancing&lt;br&gt;walsender WalSenderWriteData" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="970" y="330" width="300" height="60" as="geometry"/></mxCell><mxCell id="g3" value="received_lsn frozen&lt;br&gt;walsender WalSenderWriteData&lt;br&gt;-&gt; apply worker wait event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1300" y="330" width="330" height="60" as="geometry"/></mxCell><mxCell id="r1" value="IO:WalRead&lt;br&gt;WAL read slow:&lt;br&gt;storage IOPS / MB/s,&lt;br&gt;cold backlog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="220" y="470" width="175" height="100" as="geometry"/></mxCell><mxCell id="r2" value="CPU (NULL)&lt;br&gt;decoding CPU-bound:&lt;br&gt;backlog, unpublished&lt;br&gt;traffic, RI FULL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="410" y="470" width="175" height="100" as="geometry"/></mxCell><mxCell id="r3" value="IO:ReorderBuffer&lt;br&gt;Write / Read&lt;br&gt;big txns spilling:&lt;br&gt;logical_decoding_work_mem,&lt;br&gt;streaming (topic 07)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="600" y="470" width="190" height="100" as="geometry"/></mxCell><mxCell id="r0" value="Large txn not yet&lt;br&gt;committed / sent&lt;br&gt;(streaming off):&lt;br&gt;wait, or enable&lt;br&gt;streaming" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="810" y="470" width="160" height="100" as="geometry"/></mxCell><mxCell id="n1" value="Network slow&lt;br&gt;apply worker idle&lt;br&gt;(LogicalApplyMain)&lt;br&gt;bandwidth, latency, TCP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="990" y="470" width="260" height="100" as="geometry"/></mxCell><mxCell id="a4" value="Lock:*&lt;br&gt;find the blocker&lt;br&gt;in pg_locks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1270" y="470" width="140" height="100" as="geometry"/></mxCell><mxCell id="a5" value="ERROR /&lt;br&gt;restarts&lt;br&gt;read the error&lt;br&gt;(topic 12)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1420" y="470" width="125" height="100" as="geometry"/></mxCell><mxCell id="a6" value="CPU / IO:*&lt;br&gt;slow apply:&lt;br&gt;indexes, RI FULL,&lt;br&gt;huge txn (07/11)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1555" y="470" width="135" height="100" as="geometry"/></mxCell><mxCell id="note" value="Read the LSNs carefully&lt;br&gt;sent_lsn = walsender READ position: G2 includes changes still in the&lt;br&gt;reorder buffer (up to logical_decoding_work_mem).&lt;br&gt;write_lsn = received, replay_lsn = applied; equal when nothing is pending,&lt;br&gt;so write - replay is not an apply-lag measure. A blocked apply worker sends&lt;br&gt;no feedback: on the publisher network and apply look alike; use received_lsn." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="620" width="760" height="150" as="geometry"/></mxCell><mxCell id="b1" value="CREATE SUBSCRIPTION hangs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="820" y="640" width="200" height="40" as="geometry"/></mxCell><mxCell id="b1a" value="Old open transaction;&lt;br&gt;slot creation waits&lt;br&gt;(topic 06, 03)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="820" y="710" width="200" height="60" as="geometry"/></mxCell><mxCell id="b2" value="Table stuck in 'd' or 'i'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1040" y="640" width="200" height="40" as="geometry"/></mxCell><mxCell id="b2a" value="Topic 10: worker limits,&lt;br&gt;copy errors, sync slot&lt;br&gt;waiting for open txn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1040" y="710" width="200" height="60" as="geometry"/></mxCell><mxCell id="b3" value="Publisher disk filling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1260" y="640" width="200" height="40" as="geometry"/></mxCell><mxCell id="b3a" value="Inactive / lagging slot:&lt;br&gt;fix subscriber or drop it&lt;br&gt;(topic 05)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1260" y="710" width="200" height="60" as="geometry"/></mxCell><mxCell id="b4" value="Rows differ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1480" y="640" width="200" height="40" as="geometry"/></mxCell><mxCell id="b4a" value="confl_* counters (12);&lt;br&gt;checksums; repair or&lt;br&gt;re-sync one table (10)" style="rounded=1;whiteSpace=wrap;ht